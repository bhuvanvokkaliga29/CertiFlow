# CertiFlow Configuration

# Application
APP_NAME=CertiFlow
APP_ENV=development
SECRET_KEY=change-this-in-production-use-a-32-byte-hex-random-string
DEBUG=True
API_V1_STR=/api/v1
PUBLIC_URL=http://localhost:5173

# Database (PostgreSQL for production/docker, SQLite supported for development/testing)
DATABASE_URL=sqlite:///./certiflow.db
# For Docker / PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://certiflow:certiflow_secret@localhost:5432/certiflow

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Storage
STORAGE_DIR=./storage

# Security
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Optional Notifications (SMTP)
SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@certiflow.local

# Optional AI Assistant (Groq / OpenRouter / Gemini - strictly optional for column mapping / error explanation)
AI_PROVIDER=none
AI_API_KEY=
